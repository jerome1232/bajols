<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bajols.GroundStation.ViewModels"
        xmlns:views="using:Bajols.GroundStation.Views"
        x:Class="Bajols.GroundStation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BAJOLS Ground Station" Width="1440" Height="1000"
        MinWidth="1280" MinHeight="1000" Background="#101820">
  <Window.Styles>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1B2833" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#A9BAC8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="BAJOLS" FontSize="30" FontWeight="Bold" />
        <TextBlock Text="GROUND STATION / VEHICLE OPERATIONS" Classes="label" />
      </StackPanel>
      <Border Grid.Column="1" Classes="panel" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding Connection}" Foreground="#F2C879" VerticalAlignment="Center" />
          <Button Content="Connect" Command="{Binding ConnectCommand}" />
          <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="#342D20" CornerRadius="8" Padding="12">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#F2C879" TextWrapping="Wrap" />
    </Border>
    <Grid Grid.Row="2" RowDefinitions="Auto,*" ColumnDefinitions="*" RowSpacing="12" ColumnSpacing="12">
      <Border x:Name="AttitudePanel" Classes="panel">
        <views:SubmarineAttitude />
      </Border>
      <Border x:Name="ControlPanel" Grid.Row="1" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
          <TextBlock Text="CONTROL" Classes="label" VerticalAlignment="Center" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
            <Border x:Name="MovementControlBox" Grid.Column="1" BorderBrush="#4B6C7D" BorderThickness="1"
                    CornerRadius="6" Padding="8" HorizontalAlignment="Center">
              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16">
                <views:MovementPad x:Name="MovementPad" Width="196" Height="168"
                                   Forward="{Binding Forward, Mode=TwoWay}" Yaw="{Binding Yaw, Mode=TwoWay}" />
                <Grid Grid.Column="1" Width="112" Height="168">
                  <Border x:Name="DiveNeutralMark" Width="36" Height="2" Background="#F2C879"
                          HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <Slider x:Name="DiveControl" Orientation="Vertical" Height="168" Width="48"
                          Minimum="-1" Maximum="1" Value="{Binding Dive, Mode=TwoWay}"
                          IsDirectionReversed="True" TickFrequency="0.2" TickPlacement="Outside"
                          Foreground="#69CCC4" HorizontalAlignment="Left"
                          AutomationProperties.Name="Dive and pitch effort. Up negative, down positive." />
                  <Canvas IsHitTestVisible="False">
                    <TextBlock x:Name="DiveUpPercentage" Canvas.Left="46" Canvas.Top="7" Width="30"
                               Text="{Binding DiveUpPercentage}" TextAlignment="Center" FontSize="11" Foreground="#69CCC4" />
                    <TextBlock Canvas.Left="50" Canvas.Top="77" Text="PITCH" FontSize="10" Foreground="#A9BAC8" />
                    <TextBlock x:Name="DiveDownPercentage" Canvas.Left="46" Canvas.Top="147" Width="30"
                               Text="{Binding DiveDownPercentage}" TextAlignment="Center" FontSize="11" Foreground="#69CCC4" />
                  </Canvas>
                </Grid>
              </Grid>
            </Border>
            <Border x:Name="BuoyancyControlBox" Grid.Column="2" BorderBrush="#4B6C7D" BorderThickness="1"
                    CornerRadius="6" Padding="8" Width="140" VerticalAlignment="Stretch"
                    HorizontalAlignment="Left" Margin="16,0,0,0">
              <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <TextBlock Text="BUOYANCY" Classes="label" FontSize="11" HorizontalAlignment="Center" />
                <Grid Grid.Row="1" ColumnDefinitions="40,*" RowDefinitions="*,*,*">
                  <Slider x:Name="BuoyancyControl" Grid.RowSpan="3" Orientation="Vertical"
                          Minimum="-1" Maximum="1" TickFrequency="1" TickPlacement="Outside"
                          IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                          Value="{Binding BuoyancyPosition, Mode=TwoWay}"
                          Foreground="#69CCC4" Width="36" VerticalAlignment="Stretch"
                          AutomationProperties.Name="Buoyancy: positive up, neutral middle, negative down" />
                  <TextBlock Grid.Column="1" Text="Positive" VerticalAlignment="Top" Margin="0,6,0,0" FontSize="12" Foreground="#A9BAC8" />
                  <TextBlock Grid.Column="1" Grid.Row="1" Text="Neutral" VerticalAlignment="Center" FontSize="12" Foreground="#A9BAC8" />
                  <TextBlock Grid.Column="1" Grid.Row="2" Text="Negative" VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="12" Foreground="#A9BAC8" />
                </Grid>
              </Grid>
            </Border>
          </Grid>
          <Border x:Name="ArmActionsBox" Grid.Row="3" BorderBrush="#4B6C7D" BorderThickness="1"
                  CornerRadius="6" Padding="8">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
              <Button Content="Arm" Command="{Binding ArmCommand}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="Disarm" Command="{Binding DisarmCommand}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="2" Content="Clear failsafe" Command="{Binding ClearFailsafeCommand}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="3" Content="Emergency stop" Command="{Binding EmergencyStopCommand}" Background="#902F37" HorizontalAlignment="Stretch" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Classes="panel" Padding="12" IsVisible="{Binding IsSimulation}">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock Text="SIMULATED VEHICLE · FAULT INJECTION" Classes="label" />
        <CheckBox Content="Drop incoming movement" IsChecked="{Binding SimulateMovementLoss}" />
        <WrapPanel>
          <Button Content="Depth 5 m" Command="{Binding DepthLimitCommand}" Margin="0,0,8,0" />
          <Button Content="Depth sensor lost" Command="{Binding DepthSensorFaultCommand}" Margin="0,0,8,0" />
          <Button Content="Restore depth 2 m" Command="{Binding RestoreDepthCommand}" Margin="0,0,8,0" />
          <Button Content="Local emergency reset" Command="{Binding LocalResetCommand}" Margin="0,0,8,0" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="4" Text="{Binding LinkFreshness}" Classes="label" />
  </Grid>
</Window>
